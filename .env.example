# ---- Postgres ---------------------------------------------------------------
# Admin connection: used ONLY by audittrail-migrate (creates roles + schema).
DATABASE_ADMIN_URL=postgres://localhost:5432/audittrail?sslmode=disable
# Least-privilege runtime roles (created by the migrator).
DATABASE_URL=postgres://audittrail_app:audittrail_app@localhost:5432/audittrail?sslmode=disable
DATABASE_WORKER_URL=postgres://audittrail_worker:audittrail_worker@localhost:5432/audittrail?sslmode=disable
DATABASE_PURGE_URL=postgres://audittrail_purge:audittrail_purge@localhost:5432/audittrail?sslmode=disable
AUDITTRAIL_APP_DB_PASSWORD=audittrail_app
AUDITTRAIL_WORKER_DB_PASSWORD=audittrail_worker
AUDITTRAIL_PURGE_DB_PASSWORD=audittrail_purge

# ---- Secrets (see SECRETS.md) -----------------------------------------------
# base64 of 32 random bytes; encrypts every tenant's Ed25519 signing key.
# Generate: go run ./packages/ingestion-go/cmd/admin gen-master-key
AUDITTRAIL_MASTER_KEY=
# Bearer token for /v1/admin/* and the dashboard's server-side calls.
AUDITTRAIL_ADMIN_TOKEN=

# ---- API --------------------------------------------------------------------
LISTEN_ADDR=:8080
CORS_ORIGINS=http://localhost:3000

# ---- Checkpoint worker ------------------------------------------------------
CHECKPOINT_INTERVAL=2m
CHECKPOINT_MAX_ROWS=10000
# RFC 3161 Time-Stamp Authority for external anchoring. Set to "off" to disable.
TSA_URL=https://freetsa.org/tsr

# ---- Dashboard --------------------------------------------------------------
AUDITTRAIL_API_URL=http://localhost:8080
# Optional: require this password (HTTP basic auth, any username) for the dashboard.
DASHBOARD_PASSWORD=
