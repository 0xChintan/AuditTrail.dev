{
  "name": "@audittrail/sdk",
  "version": "0.2.0",
  "description": "Record tamper-evident audit events to AuditTrail.dev. Server-sealed hash chain, ordered offline retry queue, Express/Next.js helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "audit",
    "audit-log",
    "compliance",
    "soc2",
    "eu-ai-act",
    "tamper-evident",
    "hash-chain"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/express.ts src/next.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@audittrail/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "@types/node": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xChintan/AuditTrail.dev.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://audittrail.dev",
  "bugs": {
    "url": "https://github.com/0xChintan/AuditTrail.dev/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
