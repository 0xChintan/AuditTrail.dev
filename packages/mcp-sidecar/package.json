{
  "name": "audittrail-mcp-proxy",
  "version": "0.2.0",
  "description": "Transparent MCP proxy that hash-chains every agent tool call into AuditTrail.dev \u2014 zero code changes to the agent or the MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "audittrail-mcp-proxy": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "audit",
    "ai-agents",
    "eu-ai-act",
    "compliance",
    "proxy"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@audittrail/core": "workspace:*",
    "@audittrail/sdk": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@modelcontextprotocol/server-everything": "2026.8.31",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xChintan/AuditTrail.dev.git",
    "directory": "packages/mcp-sidecar"
  },
  "homepage": "https://audittrail.dev",
  "bugs": {
    "url": "https://github.com/0xChintan/AuditTrail.dev/issues"
  },
  "publishConfig": {
    "provenance": true
  }
}
