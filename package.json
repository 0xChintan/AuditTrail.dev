{
  "name": "audittrail",
  "private": true,
  "version": "0.1.0",
  "description": "Tamper-evident, hash-chained audit ledger for human and AI-agent actions",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "test": "pnpm -r --filter ./packages/* test",
    "typecheck": "pnpm -r typecheck",
    "go:build": "go build ./...",
    "go:test": "go test ./..."
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsup": "^8.5.0",
    "vitest": "^4.1.11",
    "@types/node": "^24.0.0"
  }
}
