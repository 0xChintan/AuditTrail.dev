# Public hostnames (DNS A/AAAA records must point at this host for ACME).
API_DOMAIN=api.audittrail.example.com
DASHBOARD_DOMAIN=app.audittrail.example.com
# Caddy global options. Production: your ACME contact. Local/CI: local_certs
CADDY_GLOBAL_OPTIONS=email ops@example.com

# Witnesses that cosign tree heads: name=url,... (independent parties in production)
WITNESSES=
CHECKPOINT_INTERVAL=2m
TSA_URL=https://freetsa.org/tsr
PURGE_INTERVAL=6h
API_DB_MAX_CONNS=20

# Prebuilt images (e.g. from the release workflow); omit to build locally.
# AUDITTRAIL_SERVER_IMAGE=ghcr.io/0xchintan/audittrail-server:0.2.0
# AUDITTRAIL_DASHBOARD_IMAGE=ghcr.io/0xchintan/audittrail-dashboard:0.2.0


# Master key in a KMS: see compose.kms.yaml and docs/DEPLOYING.md
# AUDITTRAIL_KMS_KEY_URL=awskms://alias/audittrail?region=eu-central-1

# Operator SSO: see compose.sso.yaml
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_REQUIRE_MFA=true
